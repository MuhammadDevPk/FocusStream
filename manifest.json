{
  "manifest_version": 3,
  "name": "FocusStream",
  "version": "1.0.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "js": [
        "src/content/index.ts"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
